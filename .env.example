# ============================================================
# 小蜗 · 比奇堡租房  后端 / 数据库配置
# 修改后重启 `npm run server` 生效
# ============================================================

# 后端服务端口
PORT=3001

# 数据库驱动：mysql | sqlite
#   mysql  —— 走 MySQL/MariaDB，需要下面的账号密码
#   sqlite —— 零安装，数据落在 DB_FILE 指定的文件里
# 若 mysql 连接失败，服务会自动回落到 sqlite（不会中断启动）
DB_CLIENT=mysql

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xiaowo

# ---------- SQLite（兜底） ----------
DB_FILE=server/data/xiaowo.db

# 首次启动是否导入种子数据（false 则建空表）
SEED_ON_INIT=true

# ---------- Redis（可选增强，留空则自动降级为纯数据库模式） ----------
# 本地 Docker 启动：docker run -d --name xiaowo-redis -p 6379:6379 redis:7-alpine
# 用途：社区热度榜、帖子详情缓存、发帖/评论限流
REDIS_URL=redis://127.0.0.1:6379
# key 前缀（多项目共用一个 Redis 时用于隔离）
REDIS_PREFIX=xw:
# 详情缓存秒数
REDIS_CACHE_TTL=30

# ---------- 高德地图 ----------
# 申请入口 https://console.amap.com/dev/key/app（服务平台选「Web端(JS API)」）
# 留空则地图页回落到手绘示意图
VITE_AMAP_KEY=
VITE_AMAP_SECURITY=
