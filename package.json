{
  "name": "xiaowo",
  "version": "2.0.0",
  "private": true,
  "description": "小蜗 · 比奇堡租房 — 海绵宝宝主题房屋出租平台（Vue3 + Vite + Express + MySQL/SQLite）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --experimental-sqlite server/index.js",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "npm run build && node --experimental-sqlite server/index.js",
    "db:health": "node -e \"fetch('http://127.0.0.1:3001/api/health').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\"",
    "test": "node tests/smoke.mjs",
    "db:reset": "node --experimental-sqlite scripts/reset-demo.mjs",
    "test:stress": "node --experimental-sqlite tests/stress-auction.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^6.1.0",
    "mysql2": "^3.11.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "puppeteer-core": "^25.16.0",
    "vite": "^6.0.7"
  }
}
