# 复制成 .env 后修改；docker compose 会自动读取同目录的 .env
# 注意：这个文件里的变量名和本地开发用的 DB_* 故意错开，避免 docker compose
#       读到本地 .env 里的 DB_USER=root 而把 MySQL 容器建坏。

# ---------- 数据库 ----------
# root 密码只在容器内部用，换成随机串
MYSQL_ROOT_PASSWORD=请换成随机串
MYSQL_DATABASE=xiaowo
# 应用连库用的账号（不是 root）
MYSQL_APP_USER=xiaowo
MYSQL_APP_PASSWORD=请换成随机串

# ---------- 前端（构建期注入） ----------
# 高德 Web 端(JS API) Key；改完必须重新 docker compose build web
VITE_AMAP_KEY=
# 2021-12 之后申请的 Key 一般还需安全密钥，没有就留空
VITE_AMAP_SECURITY=

# ---------- 站点 ----------
# 对外端口：本地 8080 即可；线上建议写成 127.0.0.1:8080 只给反代访问
WEB_PORT=8080
# 允许跨域的来源，多个用英文逗号分隔；留空 = 不限制（仅本地开发）
CORS_ORIGIN=
# 挂在 Caddy / Nginx 后面时设为 true
TRUST_PROXY=false
